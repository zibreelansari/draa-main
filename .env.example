# ── DRAA Platform Configuration ──────────────────────────────────────────────

# Node environment (development | production)
NODE_ENV=development

# Unified API Server Port
PORT=4000

# MongoDB Connection String (Local or MongoDB Atlas)
# Local Docker: mongodb://localhost:27017/draa
# Atlas Cloud:  mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/draa?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/draa

# CORS Allowed Origins (comma-separated)
WEB_ORIGIN=http://localhost:5173,http://localhost:5175

# Auth & Session Security
SESSION_DAYS=14
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Auto-seed initial catalog & demo accounts on boot (true | false)
SEED_DEMO=true
